{
  "name": "nomo",
  "version": "0.5.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec paraglide-js compile && vite --host 0.0.0.0",
    "build": "pnpm exec paraglide-js compile && vite build",
    "build:quicklook-renderer": "vite build --config vite.quicklook.config.ts",
    "build:quicklook-extension": "bash scripts/build-macos-quicklook.sh",
    "build:macos": "pnpm run build:quicklook-extension && bash scripts/compile-macos-appicon.sh && APPLE_SIGNING_IDENTITY=${APPLE_SIGNING_IDENTITY:--} tauri build --bundles app,dmg && bash scripts/verify-macos-bundle.sh",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "node scripts/run-tauri.mjs",
    "build:win64:nsis": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:win64:msix:dev": "pwsh -NoProfile -File scripts/msix/Build-Msix.ps1 -Mode Dev",
    "build:win64:msix:store": "pwsh -NoProfile -File scripts/msix/Build-Msix.ps1 -Mode Store",
    "test:win64:shell-extension": "pwsh -NoProfile -File scripts/msix/Build-ShellExtension.ps1 -RunTests",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lucide/svelte": "^1.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdownlint": "^0.41.1",
    "mermaid": "^11.15.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.7",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.8",
    "shiki": "^4.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.18.2",
    "@inlang/plugin-message-format": "4.4.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "knip": "^6.32.2",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.0"
  }
}
