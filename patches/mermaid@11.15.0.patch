--- /dev/null
+++ b/dist/chunks/mermaid.core/nomo-render-tasks.mjs
@@ -0,0 +1,18 @@
+// Nomo: bound each DOM rendering batch and yield to input between expensive
+// batches. State belongs to one recursive render and is released with it.
+export function createRenderTasks(root) {
+  const connected = root?.isConnected;
+  let deadline = performance.now() + 8;
+  return async (items, task) => {
+    for (let offset = 0; offset < items.length; offset += 32) {
+      if (connected && !root.isConnected) throw new DOMException("Render cancelled", "AbortError");
+      await Promise.all(items.slice(offset, offset + 32).map(task));
+      if (performance.now() >= deadline) {
+        if (globalThis.scheduler?.yield) await globalThis.scheduler.yield();
+        else await new Promise(resolve => setTimeout(resolve, 0));
+        deadline = performance.now() + 8;
+      }
+    }
+    if (connected && !root.isConnected) throw new DOMException("Render cancelled", "AbortError");
+  };
+}
